RFSOC_WEB_RUNTIME_DIR=/var/lib/rfsoc-web
RFSOC_WEB_SIMULATION=0

RFSOC_WEB_ADMIN_USERNAME=admin
RFSOC_WEB_ADMIN_PASSWORD=CHANGE_THIS_BEFORE_STARTING
RFSOC_WEB_COOKIE_SECURE=0

RFSOC_WEB_ARTIFACT_MAX_BYTES=1073741824
RFSOC_WEB_SERIAL_RECONNECT_S=3

RFSOC_WEB_VIVADO_BIN=/tools/Xilinx/Vivado/2024.2/bin/vivado
RFSOC_WEB_VIVADO_TIMEOUT_S=30
RFSOC_WEB_HW_SERVER_URL=localhost:3121
RFSOC_WEB_XSCT_BIN=/tools/Xilinx/Vitis/2024.2/bin/xsct
RFSOC_WEB_PROGRAM_TIMEOUT_S=900
RFSOC_WEB_PROGRAM_VERIFY_TIMEOUT_S=20

PYTHONUNBUFFERED=1
