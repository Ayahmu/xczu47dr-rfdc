# Vivado / Vitis generated state.  Only HDL, XDC, Tcl and checked-in XCI live
# under hardware/vivado; every project, report and log is regenerated.
.Xil/
hardware/vivado/work*/
hardware/vivado/reports*/
hardware/vivado/output/
firmware/workspace/
xsim.dir/
*.jou
*.log
*.pb
*.str
*.wdb
*.backup.*

# Chisel / Mill generated files
hardware/chisel/out/
hardware/chisel/generated/
hardware/chisel/.bsp/
hardware/chisel/test_run_dir/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/
software/dr47/build/
/dist/

# Build outputs.  artifacts/ holds the one checked-in XSA + ELF handoff; every
# other binary, and the per-build files written next to them, stays out.
*.o
*.elf
*.bin
*.bit
*.ltx
*.xsa
!/artifacts/custom_xczu47dr_waveform.xsa
!/artifacts/custom_xczu47dr_waveform.elf
artifacts/*_timing.rpt
artifacts/.program_*.xsa/
artifacts/10mhz/
artifacts/250mhz/

# Editors and OS
.vscode/
.idea/
*.swp
*~
.DS_Store
